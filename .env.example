# Git is the default snapshot transport. The repository template must contain {year} once.
LISTINGS_SOURCE_MODE=git
LISTINGS_GIT_REPOSITORY=
LISTINGS_GIT_REPOSITORY_TEMPLATE=https://github.com/SimplifyJobs/Summer{year}-Internships.git
LISTINGS_GIT_REF=refs/heads/dev
LISTINGS_GIT_PATH=.github/scripts/listings.json
GIT_FETCH_TIMEOUT_SECONDS=60

# HTTP is the protected fallback. Set LISTINGS_SOURCE_MODE=http and choose one value.
LISTINGS_URL=
LISTINGS_URL_TEMPLATE=https://raw.githubusercontent.com/SimplifyJobs/Summer{year}-Internships/dev/.github/scripts/listings.json

# Recruiting cycle and scheduling
RECRUITING_YEAR=2027
POLL_INTERVAL_HOURS=2
WINDOW_SIZE=100
STATIC_FETCH_TIMEOUT_SECONDS=15
BROWSER_FETCH_TIMEOUT_SECONDS=35
MAX_FETCH_ATTEMPTS=3

# Browser fallback. The container overrides these with its Debian arm64 package paths.
BROWSER_ENABLED=false
CHROMIUM_BINARY=
CHROMEDRIVER_PATH=
BROWSER_NO_SANDBOX=false

# Model settings. Never commit a populated key. Use a model ID available to the account.
ANTHROPIC_MODEL=replace-with-anthropic-model-id
ANTHROPIC_API_KEY=

# Safe validation mode is the default.
SHADOW_MODE=true
DATA_DIR=./runtime/data
STATE_DIR=./runtime/state
LOG_LEVEL=INFO

# Compose bind mounts. On the Pi, point both at directories on the SSD.
AUTO_INTERNER_ENV_FILE=.env
AUTO_INTERNER_DATA_DIR=./runtime/data
AUTO_INTERNER_STATE_DIR=./runtime/state
AUTO_INTERNER_MEMORY_LIMIT=1536m
AUTO_INTERNER_MEMORY_RESERVATION=256m
AUTO_INTERNER_CPUS=2.0

# Must exceed POLL_INTERVAL_HOURS plus the longest expected run.
HEALTHCHECK_MAX_AGE_SECONDS=10800

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# Local environments and secrets
.venv/
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent state. CLAUDE.md at the repo root IS tracked; this directory is
# not. It holds worktrees containing full repo copies, including a real .env.
.claude/

# Private runtime data. Keep only runtime/README.md tracked.
runtime/*
!runtime/README.md

# Generated personal documents and local browser data
*.docx
!tests/fixtures/**/*.docx
!src/auto_interner/demo_data/*.docx
*.pdf
browser-profile/

# Personal workflow helpers and agent notes. They live on disk and keep working;
# they are not part of the product and do not belong in a public tree.
CLAUDE.md
COMMIT.cmd
CLEANUP.cmd
commit-ready.ps1
FINALISE.cmd
DIAGNOSE-SMOKE.cmd
smoke-log.txt
HANDOFF-PROMPT.md
